{
  "name": "terra-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build -w @terra-pulse/web",
    "cf-types": "wrangler types apps/worker/src/worker-configuration.d.ts",
    "check": "npm run typecheck && npm run test && npm run build -w @terra-pulse/web && npm run deploy:dry",
    "db:migrate:local": "wrangler d1 migrations apply terrapulse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply terrapulse-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run cf-types && npm run build -w @terra-pulse/web && concurrently -k -n worker,web -c cyan,green \"wrangler dev --port 8787\" \"npm run dev -w @terra-pulse/web\"",
    "preview": "npm run build && wrangler dev --port 8787",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "npm run cf-types && tsc -b"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
